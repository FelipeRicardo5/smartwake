{
  "configVersion": "v3",
  "app": {
    "appId": 22062,
    "appName": "Circadia",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Circadia",
    "description": "Circadia Smart Wake Continuous Running Prototype"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.bg_service",
    "device:os.vibrator"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "debug": true,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page"
          ]
        },
        "app-service": {
          "services": [
            "app-service/smart_wake"
          ]
        }
      },
      "platforms": [
        {
          "st": "r"
        },
        {
          "st": "s"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Circadia"
    },
    "pt-BR": {
      "appName": "Circadia"
    },
    "zh-CN": {
      "appName": "Circadia"
    }
  },
  "defaultLanguage": "en-US"
}
